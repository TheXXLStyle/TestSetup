{% extends 'base.html.twig' %}

{% block title %}StreamPlus Onboarding - Step 3: Payment Information{% endblock %}

{% block body %}
    <div class="container mt-5">
        <div class="progress mb-4" role="progressbar" aria-label="Onboarding Progress" aria-valuenow="75" aria-valuemin="0" aria-valuemax="100">
            <div class="progress-bar" style="width: 75%">Step 3/4</div>
        </div>

        <h1 class="mb-4">Step 3: Payment Information</h1>

        {{ form_start(form) }}

        {# Render form rows using Bootstrap styling #}
        <div class="mb-3">
            {{ form_row(form.creditCardNumber, {'attr': {'class': 'form-control'}}) }}
        </div>
        <div class="row mb-3"> {# Expiration and CVV in one row #}
            <div class="col-md-7">
                {{ form_row(form.expirationDate, {'attr': {'class': 'form-control'}}) }}
            </div>
            <div class="col-md-5">
                {{ form_row(form.cvv, {'attr': {'class': 'form-control'}}) }}
            </div>
        </div>

        <div class="d-grid gap-2 d-md-flex justify-content-between">
            <a href="{{ back_url }}" class="btn btn-secondary">Back</a>
            <button type="submit" class="btn btn-primary">Continue to Confirmation</button>
        </div>

        {{ form_end(form) }}
    </div>
{% endblock %}