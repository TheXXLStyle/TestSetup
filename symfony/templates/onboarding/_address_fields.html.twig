{% if form.addressLine1 is defined %}
    <div class="mb-3">
        {{ form_row(form.addressLine1, {'attr': {'class': 'form-control'}}) }}
    </div>
{% endif %}

{% if form.addressLine2 is defined %}
    <div class="mb-3">
        {{ form_row(form.addressLine2, {'attr': {'class': 'form-control'}}) }}
    </div>
{% endif %}

{% if form.city is defined or form.postalCode is defined %}
    <div class="row mb-3">
        {% if form.city is defined %}
            <div class="col-md-8">
                {{ form_row(form.city, {'attr': {'class': 'form-control'}}) }}
            </div>
        {% endif %}
        {% if form.postalCode is defined %}
            <div class="col-md-4">
                {{ form_row(form.postalCode, {'attr': {'class': 'form-control'}}) }}
            </div>
        {% endif %}
    </div>
{% endif %}


{% if form.state is defined %}
    <div class="mb-3">
        {{ form_row(form.state) }}
    </div>
{% endif %}