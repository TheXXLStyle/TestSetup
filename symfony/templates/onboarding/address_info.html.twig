{% extends 'base.html.twig' %}

{% block title %}StreamPlus Onboarding - Step 2: Address{% endblock %}

{% block body %}
    {% if form.vars.errors|length > 0 %}
        <div class="alert alert-danger" role="alert">
            {{ form_errors(form) }}
        </div>
    {% endif %}
    <div class="container mt-5">
        <div class="progress mb-4" role="progressbar" aria-label="Onboarding Progress" aria-valuenow="50"
             aria-valuemin="0" aria-valuemax="100">
            <div class="progress-bar" style="width: 50%">Step 2/4</div>
        </div>

        <h1 class="mb-4">Step 2: Your Address</h1>

        {{ form_start(form, {'attr': {
            'data-controller': 'address-form',
            'data-address-form-update-url-value': path('app_onboarding_update_address_form')
        }}) }}

        <div class="mb-3">
            {{ form_row(form.country, {'attr': {
                'class': 'form-select',
                'data-address-form-target': 'countrySelect',
                'data-action': 'change->address-form#update'
            }}) }}
        </div>

        <div data-address-form-target="dependentFieldsWrapper">
            {% include 'onboarding/_address_fields.html.twig' with {'form': form} %}
        </div>

        <div class="d-grid gap-2 d-md-flex justify-content-between mt-4">
            <a href="{{ back_url }}" class="btn btn-secondary">Back</a>
            <button type="submit" class="btn btn-primary">Next</button>
        </div>

        {{ form_end(form) }}
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
{% endblock %}